{
  "name": "commitconf-store",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "clean": "rm -rf .build _site",
    "==": "========== Build ===========",
    "build:sass": "bin/compile-css",
    "build:eleventy": "npx @11ty/eleventy --formats=11ty.ts",
    "build": "npm run clean; npm-run-all build:sass build:eleventy",
    "===": "========== Watch ===========",
    "watch:sass": "inotifywait -m -r -e close_write,create,delete src/_sass/ | while read NEWFILE; do npm run build:sass && cp .build/src/_data/*.css _site/css/; done",
    "watch:eleventy": "ENV=dev npx @11ty/eleventy --serve --port=8081 --formats=11ty.ts",
    "watch": "npm run clean; npm-run-all build:sass --parallel watch:*"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@fullhuman/postcss-purgecss": "^6.0.0",
    "@types/node": "^22.7.7",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "esm": "^3.2.25",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "sass": "^1.80.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "npm-run-all": "^4.1.5",
    "react-dom": "^18.3.1",
    "save-dev": "^0.0.1-security"
  }
}
